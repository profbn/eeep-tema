    .card-contacts {
        margin-top: 26px;
        padding-top: 20px;
        border-top: 1px solid rgba(0, 0, 0, 0.12);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .contact-title {
        font-size: 0.85rem !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #555 !important;
        margin-bottom: 2px;
    }

    .contact-item {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--primary-color);
        text-decoration: underline;
        font-weight: 600;
        font-size: 0.98rem;
    }

    .contact-item:hover {
        color: #002752;
    }

    @media (max-width: 480px) {
        .card { padding: 32px 20px; }
        .card-logo { max-width: 110px; }
