</head>
<body>
<div class="bg-image"></div>
{$has_overlay}
<main class="card" role="main">
    {$logo_html}
    <h1>{$titulo}</h1>
    <p>{$msg}</p>
    {$contactos_html}
</main>
</body>
</html>
HTML;
    exit;
}, 10);
