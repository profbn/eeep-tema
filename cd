// 4. INTERCEPTAÇÃO NO FRONT-END (EXIBIÇÃO ACESSÍVEL PARA VISITANTES)
add_action('init', function() {
    global $pagenow;

    // LIBERAÇÃO ABSOLUTA: Admin e Tela de Login nunca são bloqueados
    if (is_admin() || $pagenow === 'wp-login.php' || (isset($_SERVER['REQUEST_URI']) && strpos($_SERVER['REQUEST_URI'], 'wp-login.php') !== false)) {
        return;
    }

    $modo = get_site_option('emc_modo', '0');

    // LIBERAÇÃO PARA USUÁRIOS AUTENTICADOS / ADMINS
    if ($modo === '0' || is_user_logged_in() || current_user_can('manage_options')) {
        return;
    }

    // CARREGAMENTO DE DADOS
    $bg_url    = get_site_option('emc_bg_url', '');
    $logo_url  = get_site_option('emc_logo_url', '');
    $telefone  = get_site_option('emc_telefone', '');
    $email     = get_site_option('emc_email', '');
    $instagram = get_site_option('emc_instagram', '');

    $titulo = ($modo === '503') ? 'EEEP — Em Manutenção' : 'EEEP — Em Construção';
    $msg    = ($modo === '503') 
        ? 'Estamos realizando manutenções de rotina na infraestrutura do portal. Voltamos em breve!' 
        : 'O novo portal da escola está em desenvolvimento. Em breve teremos novidades!';

    $bg_css      = $bg_url ? "background-image: url('" . esc_url($bg_url) . "');" : "background-color: #002752;";
    $has_overlay = $bg_url ? '<div class="bg-overlay"></div>' : '';

    $logo_html = $logo_url 
        ? '<img src="' . esc_url($logo_url) . '" alt="Logótipo Oficial EEEP" class="card-logo">' 
        : '';

    // BLOCO DE CONTATOS
    $contactos_html = '';
    if ($telefone || $email || $instagram) {
        $contactos_html .= '<div class="card-contacts" aria-label="Canais de Atendimento">';
        $contactos_html .= '<p class="contact-title">Canais de Atendimento:</p>';
        
        if ($telefone) {
            $tel_clean = preg_replace('/[^0-9+]/', '', $telefone);
            $contactos_html .= '<a href="tel:' . esc_attr($tel_clean) . '" class="contact-item" aria-label="Telefone ' . esc_attr($telefone) . '">';
            $contactos_html .= '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>';
            $contactos_html .= esc_html($telefone) . '</a>';
        }
        if ($email) {
            $contactos_html .= '<a href="mailto:' . esc_attr($email) . '" class="contact-item" aria-label="E-mail ' . esc_attr($email) . '">';
            $contactos_html .= '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>';
            $contactos_html .= esc_html($email) . '</a>';
        }
        if ($instagram) {
            $insta_link = (strpos($instagram, 'http') === 0) ? $instagram : 'https://instagram.com/' . ltrim($instagram, '@');
            $contactos_html .= '<a href="' . esc_url($insta_link) . '" target="_blank" rel="noopener noreferrer" class="contact-item" aria-label="Instagram ' . esc_attr($instagram) . '">';
            $contactos_html .= '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>';
            $contactos_html .= esc_html($instagram) . '</a>';
        }
        $contactos_html .= '</div>';
    }

    status_header((int)$modo);
    header('Content-Type: text/html; charset=utf-8');

    echo <<<HTML
